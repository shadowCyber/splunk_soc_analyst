<dashboard version="1.1" theme="dark">
  <label>Cyber Defense Triage Dashboard</label>
  <description>Active alert queue &#x2014; filter by tier, severity, or owner. Click any row to open Alert Detail.</description>
  <refresh>300</refresh>

  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time_range" searchWhenChanged="true">
      <label>Time Range</label>
      <default>
        <earliest>-24h@h</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="filter_severity" searchWhenChanged="true">
      <label>Severity</label>
      <choice value="*">All Severities</choice>
      <choice value="critical">&#x1F534; Critical</choice>
      <choice value="high">&#x1F7E0; High</choice>
      <choice value="medium">&#x1F7E1; Medium</choice>
      <choice value="low">&#x1F7E2; Low</choice>
      <default>*</default>
    </input>
    <input type="dropdown" token="tier_filter" searchWhenChanged="true">
      <label>Tier Queue</label>
      <choice value="*">All Tiers</choice>
      <choice value="t1">T1 &#x2014; Intake</choice>
      <choice value="t2">T2 &#x2014; Investigate</choice>
      <choice value="t3">T3 &#x2014; Hunt/Tune</choice>
      <default>*</default>
    </input>
    <input type="text" token="my_queue" searchWhenChanged="true">
      <label>Filter by Owner</label>
      <default></default>
    </input>
  </fieldset>
  <row>
    <panel>
      <html>
        <style>
          body,.appBackground,#view,#content,.main-content-body,.splunk-components,.shared-page-chrome,
          .dashboard-body,.dashboard-row .dashboard-cell,.page-content{background-color:#1a1a24!important;color:#c7d0dd!important}
          .dashboard-panel,.panel-body,.panel-head{background-color:#23232f!important;color:#c7d0dd!important;border-color:#3c3c4e!important}
          .panel-head h3{color:#a9b7c6!important;font-size:13px!important;letter-spacing:.3px;}
          thead th,.table th{background-color:#2c2c3a!important;color:#8be0f7!important;border-color:#3c3c4e!important;font-size:12px!important;}
          .splunk-table tbody td,.table tbody td{color:#c7d0dd!important;background-color:#23232f!important;border-color:#3c3c4e!important;font-size:12px!important;}
          .splunk-table tbody tr:nth-child(even) td{background-color:#1f1f2e!important}
          .splunk-table tbody tr:hover td{background-color:#2a3a52!important;cursor:pointer;}
          .fieldset,.dashboard-fieldset,.splunk-textinput input,.splunk-dropdown .btn,.btn-default,.control-group .controls input,select{background-color:#2c2c3a!important;color:#c7d0dd!important;border-color:#4a4a5e!important;}
          .shared-appnav,.appbar,.navbar,.navbar-default{background-color:#13131a!important;border-bottom-color:#2a2a3a!important;}
          .shared-appnav a,.navbar a{color:#8be0f7!important;}
          .highcharts-plot-background,.highcharts-background{fill:#1f1f2e!important;}
          .highcharts-axis-labels text,.highcharts-axis text,.highcharts-legend-item text{fill:#a9b7c6!important;}
          .highcharts-grid-line{stroke:#2c2c3a!important;}
          .shared-singlevalue .number{color:#8be0f7!important;}
          .shared-description,.description{color:#868e96!important;font-size:12px!important;}
          .splunk-list-accordion .accordion-heading a,.splunk-list-accordion .accordion-group{background:#23232f!important;color:#c7d0dd!important;border-color:#3c3c4e!important;}
          ::-webkit-scrollbar{background:#1a1a24;width:6px;height:6px;}
          ::-webkit-scrollbar-thumb{background:#3c3c4e;border-radius:3px;}
        </style>
      </html>
    </panel>
  </row>

  <!-- ─── KPI Command Strip ─────────────────────────────────────────────── -->
  <row>
    <panel>
      <title>Open Alerts</title>
      <single>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" | stats dc(alert_id) as count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[10,30]</option>
        <option name="underLabel">alerts requiring action</option>
      </single>
    </panel>
    <panel>
      <title>Critical / High</title>
      <single>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" AND (severity="critical" OR severity="high") | stats dc(alert_id) as count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xffa94d","0xdc4e41"]</option>
        <option name="rangeValues">[1,5]</option>
        <option name="underLabel">critical + high priority</option>
      </single>
    </panel>
    <panel>
      <title>SLA Breached</title>
      <single>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" | eval due=strptime(sla_due,"%Y-%m-%dT%H:%M:%SZ") | where now()&gt;due | stats dc(alert_id) as count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xffa94d","0xdc4e41"]</option>
        <option name="rangeValues">[1,3]</option>
        <option name="underLabel">past SLA deadline</option>
      </single>
    </panel>
    <panel>
      <title>Unassigned</title>
      <single>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" AND (isnull(owner) OR owner="") | stats dc(alert_id) as count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[3,10]</option>
        <option name="underLabel">no analyst assigned</option>
      </single>
    </panel>
    <panel>
      <title>Avg Risk Score</title>
      <single>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" | stats avg(risk_score) as score | eval score=round(score,0)</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="colorMode">none</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[50,75]</option>
        <option name="underLabel">open alert risk average</option>
      </single>
    </panel>
  </row>

  <!-- ─── Alert Queue ──────────────────────────────────────────────────── -->
  <row>
    <panel>
      <title>Open Alert Queue &#x2014; Click row to triage</title>
      <table>
        <search>
          <query>`soc_alerts_normalized`
| where status!="closed"
| where "$filter_severity$"="*" OR severity="$filter_severity$"
| where "$tier_filter$"="*" OR coalesce(tier_queue,"t1")="$tier_filter$"
| where "$my_queue$"="" OR owner="$my_queue$"
| eval Priority=case(severity="critical","&#x1F534; CRITICAL",severity="high","&#x1F7E0; HIGH",severity="medium","&#x1F7E1; MEDIUM",severity="low","&#x1F7E2; LOW",true(),"&#x26AA; ?"),
       Tier=coalesce(tier_queue,"t1"),
       _created=strptime(created_at,"%Y-%m-%dT%H:%M:%SZ"),
       _due=strptime(sla_due,"%Y-%m-%dT%H:%M:%SZ"),
       Age=case((now()-_created)&lt;3600,round((now()-_created)/60,0)." min",(now()-_created)&lt;86400,round((now()-_created)/3600,1)." hrs",true(),round((now()-_created)/86400,1)." days"),
       SLA_Left=if(now()&gt;_due,"&#x26A0;&#xFE0F; OVER ".round((now()-_due)/60,0)." min","&#x2705; ".round((_due-now())/60,0)." min left"),
       Owner=if(isnull(owner) OR owner="","&#x26A0;&#xFE0F; UNASSIGNED",owner),
       risk_score=tonumber(risk_score)
| sort - risk_score
| rename alert_id as "Alert ID", rule_name as "Detection Rule", entity as Entity, risk_score as "Risk Score", status as Status, triage_last_updated as "Last Updated"
| table "Alert ID" "Detection Rule" Entity Priority "Risk Score" Age Status Owner Tier SLA_Left "Last Updated"</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">row</option>
        <option name="wrap">true</option>
        <drilldown>
          <link target="_self">/app/soc_triage_app/alert_detail?form.alert_id=$row.Alert ID$</link>
        </drilldown>
      </table>
    </panel>
  </row>

  <!-- ─── Situational Awareness ────────────────────────────────────────── -->
  <row>
    <panel>
      <title>Severity Distribution (Open Alerts)</title>
      <chart>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" | stats count by severity | sort - count</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="charting.chart">pie</option>
        <option name="charting.seriesColors">[0xdc4e41,0xff6b6b,0xffa94d,0xffd43b,0x748ffc]</option>
      </chart>
    </panel>
    <panel>
      <title>SLA Breached &#x2014; Overdue by (minutes)</title>
      <table>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" | eval due=strptime(sla_due,"%Y-%m-%dT%H:%M:%SZ") | where now()&gt;due | eval Overdue_min=round((now()-due)/60,0) | eval Priority=case(severity="critical","&#x1F534; CRITICAL",severity="high","&#x1F7E0; HIGH",severity="medium","&#x1F7E1; MEDIUM",true(),"&#x1F7E2; LOW") | sort - Overdue_min | table alert_id rule_name entity owner Priority risk_score Overdue_min sla_due</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="count">10</option>
        <option name="drilldown">row</option>
        <drilldown>
          <link target="_self">/app/soc_triage_app/alert_detail?form.alert_id=$row.alert_id$</link>
        </drilldown>
      </table>
    </panel>
  </row>

  <row>
    <panel>
      <title>Top Firing Detection Rules</title>
      <chart>
        <search>
          <query>`soc_alerts_normalized` | stats count by rule_name | sort - count | head 8</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="charting.chart">bar</option>
        <option name="charting.chart.orientation">horizontal</option>
        <option name="charting.seriesColors">[0x4dabf7]</option>
        <option name="charting.axisTitleX.visibility">collapsed</option>
      </chart>
    </panel>
    <panel>
      <title>Analyst Workload (Open Alerts)</title>
      <table>
        <search>
          <query>`soc_alerts_normalized` | where status!="closed" | eval Owner=if(isnull(owner) OR owner="","&#x26A0;&#xFE0F; unassigned",owner) | stats count as Open avg(risk_score) as Avg_Risk values(severity) as Severities by Owner | eval Avg_Risk=round(Avg_Risk,1) | sort - Open</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="count">15</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>

  <!-- ─── Bulk Triage ───────────────────────────────────────────────────── -->
  <row>
    <panel>
      <title>&#x26A1; Bulk Triage &#x2014; Apply status/owner to a group of alerts</title>
      <input type="dropdown" token="bulk_status" searchWhenChanged="false">
        <label>Set Status</label>
        <choice value="new">New</choice>
        <choice value="in_progress">In Progress</choice>
        <choice value="closed">Closed</choice>
        <default>in_progress</default>
      </input>
      <input type="dropdown" token="bulk_owner" searchWhenChanged="false">
        <label>Assign To</label>
        <populatingSearch fieldForLabel="display_label" fieldForValue="username">
          | inputlookup soc_analyst_roster | where active="true"
          | eval display_label=display_name." [".tier."]"
          | table username display_label
          | sort display_label
        </populatingSearch>
        <choice value="">&#x2014; Unassigned &#x2014;</choice>
        <default></default>
      </input>
      <input type="dropdown" token="bulk_filter" searchWhenChanged="false">
        <label>Apply To</label>
        <choice value="unassigned">All Unassigned Open Alerts</choice>
        <choice value="severity_critical">All Open Critical Alerts</choice>
        <choice value="severity_high">All Open High Alerts</choice>
        <choice value="sla_breach">All SLA-Breached Open Alerts</choice>
      </input>
      <input type="radio" token="bulk_confirm" searchWhenChanged="true">
        <label>&#x26A0;&#xFE0F; Confirm Bulk Write</label>
        <choice value="">&#x23F8;&#xFE0F; Not yet &#x2014; still reviewing</choice>
        <choice value="yes">&#x2705; CONFIRM &#x2014; apply bulk changes now</choice>
        <default></default>
      </input>
      <table id="bulk_triage_write" depends="$bulk_confirm$">
        <title>Result</title>
        <search>
          <query>`soc_alerts_normalized`
| where case(
    "$bulk_filter$"="unassigned",        status!="closed" AND (isnull(owner) OR owner=""),
    "$bulk_filter$"="severity_critical",  status!="closed" AND severity="critical",
    "$bulk_filter$"="severity_high",      status!="closed" AND severity="high",
    "$bulk_filter$"="sla_breach",         status!="closed" AND now()&gt;strptime(sla_due,"%Y-%m-%dT%H:%M:%SZ"),
    true(), false())
| eval _key=alert_id, status="$bulk_status$", owner="$bulk_owner$", last_updated=strftime(now(),"%Y-%m-%dT%H:%M:%SZ")
| table _key alert_id status owner last_updated
| outputlookup append=false soc_alert_triage
| stats count as updated
| eval result="&#x2705; Bulk update complete: ".updated." alert(s) &#x2192; status=$bulk_status$, owner=$bulk_owner$"
| table result</query>
          <earliest>$time_range.earliest$</earliest>
          <latest>$time_range.latest$</latest>
        </search>
        <option name="drilldown">none</option>
        <option name="count">1</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <html>
        <div style="padding:8px 4px;border-top:1px solid #2c2c3a;display:flex;gap:24px;align-items:center;">
          <span style="color:#4a4a5e;font-size:12px;">&#x1F5FA;&#xFE0F; Navigate:</span>
          <a href="/app/soc_triage_app/overview" style="color:#4dabf7;font-size:13px;text-decoration:none;">&#128196; Overview</a>
          <a href="/app/soc_triage_app/analyst_metrics" style="color:#4dabf7;font-size:13px;text-decoration:none;">&#128202; Analyst Metrics</a>
          <a href="/app/soc_triage_app/suppression" style="color:#4dabf7;font-size:13px;text-decoration:none;">&#128683; Suppressions</a>
        </div>
      </html>
    </panel>
  </row>

</dashboard>
